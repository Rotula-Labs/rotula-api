{
  "root": true,
  "env": {
    "node": true,
    "es2021": true
  },
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "2021",
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "rules": {
    "no-console": "warn"
  },
  "overrides": [
    {
      "files": ["src/services/observability.service.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["tests/**/*.ts", "**/*.test.ts", "**/*.test.js"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
